# Copie para n8n/.env.n8n e preencha. NUNCA versione o arquivo preenchido.
# Usado só por n8n/docker-compose.n8n.yml (n8n self-hosted).

# Banco do n8n
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# Cifra as credenciais salvas no n8n. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# GUARDE ESTA CHAVE: perdê-la significa perder todas as credenciais salvas.
N8N_ENCRYPTION_KEY=

# Endereço público do n8n (só mude se usar domínio/túnel)
WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PROTOCOL=http
