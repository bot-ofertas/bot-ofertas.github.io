# Credenciais — nunca subir
.env
# Cópia de segurança e temporário da gravação atômica do .env
# (setup_n8n.gravar_no_env). Carregam TOKEN_TELEGRAM e N8N_TOKEN em
# claro — este repositório é a página pública do projeto.
.env.bak
.env.novo.*

# Cache Python
__pycache__/
*.py[cod]
*.pyo

# Dados locais (não subir para o GitHub)
envios.log
rastreador.log
data/rastreador_auto.log
data/ml_profile/
data/bot_ofertas.db
data/processos.txt
data/teste_completo.log

# Sessão do WhatsApp (CREDENCIAIS — nunca subir)
data/wa_profile/
data/chrome_bot/
data/qr.png
data/qr_b64.txt
data/wa_status.txt
data/wa_foto_*.jpg
data/wa_verify*.png
data/preview_foto.png
data/setup_wa.log
data/pw_err.log
data/pw_test.log
data/bridge.log
data/rastreador.pid
data/rastreador_local.log

# Logs, PIDs e bancos locais (gerados em runtime, não fazem parte do código)
data/*.log
data/*.log.err
data/*.pid
data/*.db
data/*.jsonl
data/_*.json
data/n8n/
data/n8n_startup.log
data/n8n_spool.jsonl
# Fallback do bloco de notas quando não existe Desktop (Linux/CI)
data/Problemas de execu*.txt
data/site_publisher_last.txt
data/ig_login_backoff.json
data/wa_desktop_*.jpg
data/wa_upload.jpg

# web/ foi substituído por docs/ (o que o GitHub Pages realmente publica)
web/

# n8n — segredos e estado local do instalador
n8n/.env.n8n
n8n/.n8n_state.json
data/pausado.flag

# Arquivos temporários
*.zip
afiliabot_v3/

# Saída do `setup_n8n.py --preparar`: workflows com o chat_id já
# preenchido. É gerado, não fonte — e versioná-lo colocaria dados da
# instalação do Daniel no repositório.
n8n/prontos/
