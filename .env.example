# Copie para .env e preencha com seus valores reais
# NUNCA suba o arquivo .env para o GitHub.

# ── Telegram ──────────────────────────────────────────────
TOKEN_TELEGRAM=cole_aqui_o_token_do_BotFather
CANAL_GERAL=-100XXXXXXXXXXX

# ── Mercado Livre ─────────────────────────────────────────
# Com ML_APP_ID + ML_APP_SECRET preenchidos, o token é obtido e RENOVADO
# sozinho (core/ml_token.py) — o token do ML dura ~6h, e antes disso era
# preciso rodar `python ml_auth.py` à mão toda vez que vencia.
ML_APP_ID=seu_app_id
ML_APP_SECRET=seu_app_secret
# Só para compatibilidade com quem já rodou `python ml_auth.py`. Se
# ML_APP_ID/SECRET estiverem preenchidos, este campo nem é usado.
ML_ACCESS_TOKEN=
ML_AFFILIATE_TOOL_ID=47114387

# ── Amazon Associates Brasil (opcional) ───────────────────
# Crie sua conta em: https://associados.amazon.com.br/
# Formato: seu-apelido-20  (ex: meublog-20)
# Sem esta variável, o rastreador_amazon.py não roda.
AMAZON_AFFILIATE_TAG=

# ── Amazon PA-API oficial (opcional, além do AMAZON_AFFILIATE_TAG) ────
# Enriquece/valida produtos com dados oficiais (preço, título, foto) via
# API em vez de só raspar a página. Exige conta com 3+ vendas em 180 dias.
# Gera em: https://affiliate-program.amazon.com.br/assoc_credentials/home
# Sem essas variáveis, o bot continua funcionando normalmente só com o scraper.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=

# ── IA — reescrita de títulos (opcional) ──────────────────
ANTHROPIC_API_KEY=

# ── n8n (automação em nuvem) ──────────────────────────────
# Guia completo: n8n/README.md
# Sem N8N_WEBHOOK_URL, toda a integração vira no-op e o bot roda igual.
# URL do webhook que recebe os eventos (impressa por n8n/setup_n8n.py)
N8N_WEBHOOK_URL=
# Segredo que autentica os webhooks (invente um longo e aleatório).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_TOKEN=
# Liga/desliga a integração sem apagar as outras variáveis (1 = ligada)
N8N_ATIVO=1
# Intervalo do heartbeat em segundos (é o que sustenta o watchdog na nuvem)
N8N_HEARTBEAT_S=300
# Só para o instalador n8n/setup_n8n.py:
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
# Pasta de dados do n8n, se o seu n8n roda com uma própria (o padrão é
# ~/.n8n). A CLI PRECISA da mesma: com o servidor numa pasta e a CLI noutra,
# o `import:workflow` imprime sucesso gravando num segundo banco, e a
# interface continua vazia. O instalador adivinha `data/n8n` quando acha um
# database.sqlite lá, mas preencher aqui é o certo.
N8N_USER_FOLDER=
# Endereço do healthcheck acessível pelo n8n — SÓ para o workflow 05
# (comandos remotos). Vazio = comandos desligados, o resto funciona igual.
# O `setup_n8n.py --configurar` preenche isto sozinho com 127.0.0.1 quando o
# n8n roda NESTA máquina: aí o caminho de volta já existe e não abre porta
# nenhuma. Com o n8n fora daqui ele deixa vazio de propósito — apontar para
# fora exigiria expor na rede um endpoint que pausa a operação, e essa
# decisão é sua.
BOT_API_URL=
# Interface onde o healthcheck escuta. Mudar para 0.0.0.0 expõe a API na
# rede local: só faça isso com N8N_TOKEN definido.
HEALTHCHECK_BIND=127.0.0.1

# ── WhatsApp ──────────────────────────────────────────────
# O envio usa o WhatsApp Desktop ja instalado e logado nesta maquina
# (automacao de UI da sessao autenticada) e publica SO no grupo abaixo.
#
# WHATSAPP_GROUP_ID e a CHAVE GERAL: vazio aqui significa WhatsApp
# desligado, e a fila registra "wa_ativo=False" e nao envia nada. Nao e
# opcional — sem ele nao existe postagem no grupo. Como obter: abra
# https://web.whatsapp.com, entre no grupo e copie o trecho depois de
# /accounts/ ... ou rode `python -m integrations.whatsapp_api --grupos`
# se a Evolution API estiver configurada.
WHATSAPP_GROUP_ID=cole_aqui_o_id_do_grupo
# Nome do grupo COMO APARECE na lista de conversas do WhatsApp Desktop — e
# por ele que a automacao acha a conversa (Ctrl+F). Precisa bater exatamente,
# incluindo acentos e emojis; nome errado significa nao achar a conversa.
WHATSAPP_GROUP_NAME=Bot-Ofertas
# Intervalo aleatorio entre envios fica no whatsapp_queue_sender.py (30-45min)
# de proposito: publicar no mesmo instante do Telegram, sempre, e o padrao
# mais facil de reconhecer como bot.

# ── Grupos e divulgação ───────────────────────────────────
# Links usados no CTA de todo post e nos anúncios gerados
GRUPO_TELEGRAM_URL=https://t.me/ofertaseletronics
GRUPO_WHATSAPP_URL=https://chat.whatsapp.com/JyJ9uLoZdE5LboH9GjAooC

# ── Publicação ────────────────────────────────────────────
# Quando a foto do produto não puder ser baixada, publicar mesmo assim com
# o preview nativo do link (que carrega a foto oficial do anúncio).
# 0 = comportamento estrito: sem foto, não publica.
PUBLICAR_SEM_FOTO=1
# Timeouts do cliente do Telegram, em segundos (upload de foto em conexão
# doméstica estoura o padrão de 5s da biblioteca)
TELEGRAM_TIMEOUT_CONEXAO=10
TELEGRAM_TIMEOUT_LEITURA=40

# ── Site e administração ──────────────────────────────────
# URL pública do site (usada nos botões do Telegram)
SITE_URL=https://bot-ofertas.github.io/
# IDs de chat autorizados a usar /status e /stats (separados por vírgula)
ADMIN_IDS=
# Chat que recebe os alertas do n8n (normalmente o primeiro de ADMIN_IDS).
# Descubra mandando /start pro bot e abrindo:
#   https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
ADMIN_CHAT_ID=

# ── Ciclo diário do PC (liga/desliga) ─────────────────────
# Estes dois horários são a fonte única: geram as tarefas do Agendador do
# Windows (agendar_shutdown.ps1), o supervisor que garante o bot de pé
# (garantir_bot.py) e a janela de silêncio do watchdog no n8n. Mudar aqui e
# rodar `.\agendar_shutdown.ps1` + `python n8n/setup_n8n.py --importar`
# reconfigura tudo junto.
# A janela pode atravessar a meia-noite (08:30 → 02:00 do dia seguinte).
HORA_LIGAR=08:30
HORA_DESLIGAR=02:00
# Verificação diária (relatório de saúde) — antes do desligamento.
HORA_VERIFICACAO=01:00
